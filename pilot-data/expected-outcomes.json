  "known_design_questions": [
    {
      "id": "Q1",
      "title": "Service-level grouping across event families",
      "detail": "Architecture 3 narrates 'Grafana latency + Azure CPU -> one incident: Payment API degradation'. The tech-sheet-10 fingerprint (env+service+resource+event_family) cannot produce that, because the families differ. This fixture encodes the tech-sheet-10 rule: S01 and S02 are TWO incidents. If service-level grouping is wanted, it is a new correlation rule and needs an architecture decision before Slice 3.",
      "affects": [
        "S01",
        "S02"
      ],
      "blocks_slice": 3
    },
    {
      "id": "Q2",
      "title": "Sub-minute flap policy",
      "detail": "S16 recovers in 45s. Source inventory 10 asks whether 30s / 2min / 15min recoveries should behave differently. This fixture treats it as a normal incident. Revisit with the real pilot user.",
      "affects": [
        "S16"
      ],
      "blocks_slice": null
    },
    {
      "id": "Q3",
      "title": "uptime_kuma Down maps to critical for every monitor",
